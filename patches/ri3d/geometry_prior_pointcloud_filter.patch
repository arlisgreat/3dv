+def exact_point_subset(keep, target_points):
+    target_points = int(target_points)
+    if target_points <= 0:
+        return keep
+    indices = np.flatnonzero(keep)
+    if indices.size <= target_points:
+        return keep
+    selected = np.linspace(0, indices.size - 1, target_points).astype(np.int64)
+    subset = np.zeros_like(keep, dtype=bool)
+    subset[indices[selected]] = True
+    return subset
+
+
+def pointcloud_filter_for_frame(
+        cam_info, confidence, depth_rel, min_points, conf_threshold,
+        use_frame_mask=True, target_points=0, verbose=True):
+    valid = np.isfinite(depth_rel).reshape(-1) & (depth_rel.reshape(-1) > 1e-6)
+    keep = valid.copy()
+
+    if confidence is not None:
+        conf = confidence
+        if conf.ndim == 3:
+            conf = conf[..., 0]
+        keep &= conf.reshape(-1) >= conf_threshold
+
+    if use_frame_mask and getattr(cam_info, "mask", None) is not None:
+        frame_mask = cam_info.mask
+        if frame_mask.shape != depth_rel.shape:
+            frame_mask = cv2.resize(frame_mask, (depth_rel.shape[1], depth_rel.shape[0]), interpolation=cv2.INTER_NEAREST)
+        keep &= frame_mask.reshape(-1) > 0.5
+
+    if int(keep.sum()) < int(min_points):
+        if verbose:
+            print(
+                f"Pointcloud mask filter fallback for {cam_info.image_name}: "
+                f"{int(keep.sum())} kept < {int(min_points)} min points"
+            )
+        keep = valid
+
+    keep = exact_point_subset(keep, target_points)
+    if verbose:
+        print(f"Pointcloud mask filter for {cam_info.image_name}: {int(keep.sum())}/{keep.size} points kept")
+    return keep
+
+

