# External repositories are managed by scripts and manifests.
/external/*/

# Local experiment outputs. Track compact metadata plus PNG/MP4 results.
/experiments/inputs/**
/experiments/pseudo_views/**
/experiments/reconstructions/**
/experiments/metrics/**
/experiments/figures/**
!/experiments/README.md
!/experiments/inputs/
!/experiments/inputs/**/
!/experiments/inputs/**/README.md
!/experiments/inputs/**/*.csv
!/experiments/inputs/**/*.json
!/experiments/inputs/first10/cutouts/*.png
!/experiments/pseudo_views/
!/experiments/pseudo_views/**/
!/experiments/pseudo_views/**/README.md
!/experiments/pseudo_views/**/metadata.json
!/experiments/pseudo_views/**/manifest.json
!/experiments/pseudo_views/**/*.png
!/experiments/reconstructions/
!/experiments/reconstructions/**/
!/experiments/reconstructions/**/README.md
!/experiments/reconstructions/**/metadata.json
!/experiments/reconstructions/**/summary.json
!/experiments/reconstructions/**/*.mp4
!/experiments/metrics/
!/experiments/metrics/**/
!/experiments/metrics/**/*.csv
!/experiments/metrics/**/*.json
!/experiments/metrics/**/*.md
!/experiments/figures/
!/experiments/figures/**/
!/experiments/figures/**/*.md
!/experiments/figures/**/*.png

# Common local artifacts.
__pycache__/
*.pyc
.DS_Store
/.cache/
